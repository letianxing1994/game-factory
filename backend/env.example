# ──────────────── API Server ────────────────
PORT=4000
NODE_ENV=development
LOG_LEVEL=info
JWT_SECRET=replace-me

# ──────────────── Database & Cache ────────────────
# 注意：代码中使用 DB_* 前缀，但为了兼容性也支持 MYSQL_* 前缀
DB_HOST=localhost
DB_PORT=3306
DB_USER=game_factory
DB_PASSWORD=secret
DB_NAME=game_factory
# 兼容旧配置（如果设置了 MYSQL_*，代码会优先使用 DB_*）
# MYSQL_HOST=localhost
# MYSQL_PORT=3306
# MYSQL_USER=game_factory
# MYSQL_PASSWORD=secret
# MYSQL_DATABASE=game_factory

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379/1
REDIS_PASSWORD=

# ──────────────── Kafka ────────────────
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=game-factory-backend
KAFKA_GROUP_ID=game-factory-api
KAFKA_SSL=false
KAFKA_SASL_MECHANISM=plain
KAFKA_SASL_USERNAME=
KAFKA_SASL_PASSWORD=
WORKFLOW_TASK_TOPIC=workflow-tasks
WORKFLOW_RESULT_TOPIC=workflow-results
AGENT_EVENT_TOPIC=agent-events

# ──────────────── Downstream my-agent-test 服务 ────────────────
MY_AGENT_BASE_URL=http://localhost:8080/api
MY_AGENT_API_KEY=
# 兼容旧配置
# A2A_BASE_URL=http://localhost:8080
# A2A_WS_URL=ws://localhost:8080
# A2A_API_TOKEN=

# ──────────────── 对象存储（可选） ────────────────
OSS_REGION=oss-cn-hangzhou
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=

GCP_PROJECT_ID=
GCS_BUCKET=
GCS_CREDENTIALS_JSON=

# ──────────────── JWT 认证 ────────────────
JWT_EXPIRES_IN=7d

# ──────────────── Workflow 队列配置 ────────────────
WORKFLOW_CONCURRENCY=25
WORKFLOW_AVG_TIME_MS=180000
WORKFLOW_RESULT_GROUP=game-factory-workflow-results

# ──────────────── 前端配置 ────────────────
FRONTEND_URL=http://localhost:5173

# ──────────────── 速率 & 安全（可选） ────────────────
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
CORS_ALLOW_ORIGIN=http://localhost:5173

